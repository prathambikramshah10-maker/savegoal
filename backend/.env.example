# ============================================================
# SaveGoal Backend Environment Variables
# Copy this file to .env and fill in real values.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Allowed CORS origins (comma-separated). In production add your live domains, e.g.:
# CORS_ORIGIN=https://savegoal.com,https://www.savegoal.com,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# MongoDB (Railway: add the MongoDB plugin and use its ${{ MONGODB_URL }} variable)
MONGODB_URI=mongodb://localhost:27017/savegoal

# JWT - use a LONG random string in production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE=7d

# ---- Gmail SMTP (REQUIRED for real email OTP delivery) ----
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and the 16-character app password below.
#    Real 6-digit OTP codes are emailed through this account.
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# ---- OTP + session security ----
# Generate with:  node -e "console.log('OTP_SECRET='+require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=change-this-to-a-long-random-hex-string

# Used to sign any future server-side session cookies / CSRF tokens.
SESSION_SECRET=change-this-to-another-long-random-hex-string

# Admin bootstrap (optional - creates an admin on startup)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@savegoal.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_PHONE=9800000000